# Universal Bank Statement Parser - Environment Variables
# Copy this file to .env and fill in your values.
# Never commit your actual .env file to version control.

# ---------------------------------------------------------------------------
# REQUIRED: Google Gemini API Key
# Get yours at: https://aistudio.google.com/app/apikey
# Required for:
#   - Tier 3: LLM fallback on pages where regex/xpos parsing fails
#   - Tier 4: Vision-based parsing for scanned/image PDFs
#   - Schema discovery (discover_schema step)
# The parser will still work for simple digital PDFs without a key,
# but accuracy may be lower on complex layouts.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------------------------
# OPTIONAL: LLM-assisted EMI classification (secondary pass)
# When enabled, debits classified as "Other" are sent to Gemini for a
# second opinion on whether they are EMIs or bounce charges.
# Default: false (disabled to avoid unnecessary API costs)
# ---------------------------------------------------------------------------
BANK_PARSER_LLM_EMI_ENABLED=false

# Max number of transactions to send per statement (to control cost)
BANK_PARSER_LLM_EMI_MAX_TRANSACTIONS=120

# Minimum debit amount (INR) to consider for LLM EMI pass
BANK_PARSER_LLM_EMI_MIN_DEBIT=500

# ---------------------------------------------------------------------------
# OPTIONAL: GST Intelligence (gst_intelligence.py)
# Primary: IRIS GST API - https://taxpayer.irisgst.com
# ---------------------------------------------------------------------------
IRIS_GST_BASE_URL=https://taxpayer.irisgst.com/api
IRIS_GST_API_KEY=your_iris_gst_api_key_here

# Fallback: JamKu GST endpoint (legacy)
# Leave blank if not using JamKu
JAMKU_BASE_URL=
